{
  "name": "smartsort-fleet-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "JumpSpaces-internal fleet monitor for SmartSort POS deployments",
  "author": "JumpSpaces",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "happy-dom": "^21.0.4",
    "typescript": "~6.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.10"
  }
}
